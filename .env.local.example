NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# LiveKit (voz/video). Cloud "Build" tier al inicio; al migrar a self-hosted en
# Hostinger + Easypanel solo cambian estas variables — el código no se reescribe.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxxxx
LIVEKIT_API_SECRET=xxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud

# AI agents — UUID del usuario "FM Bot" creado por la migración 0082.
# Mismo valor debe configurarse en el servicio ai-worker.
FM_BOT_USER_ID=00000000-0000-0000-0000-000000000b07
